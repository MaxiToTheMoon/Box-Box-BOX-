# Local environment and OS files
.venv/
.DS_Store
Thumbs.db

# Get latest from https://github.com/github/gitignore/blob/main/Unity.gitignore
#
# Recommended: add any editor/OS/tool-specific ignore rules from the Global/ templates as needed.
# See: https://github.com/github/gitignore/tree/main/Global
#
.utmp/
/Box!Box!BOX!/[Ll]ibrary/
/Box!Box!BOX!/[Tt]emp/
/Box!Box!BOX!/[Oo]bj/
/Box!Box!BOX!/[Bb]uild/
/Box!Box!BOX!/[Bb]uilds/
/Box!Box!BOX!/[Ll]ogs/
/Box!Box!BOX!/[Uu]ser[Ss]ettings/
*.log

# Memory Profiler generated files
# MemoryCaptures can get excessive in size
# They also could contain extremely sensitive data
/Box!Box!BOX!/[Mm]emory[Cc]aptures/

# Recordings can get excessive in size
/Box!Box!BOX!/[Rr]ecordings/

# Uncomment this line if you wish to ignore the asset store tools plugin
# /Box!Box!BOX!/[Aa]ssets/AssetStoreTools*

# Autogenerated Jetbrains Rider plugin
/Box!Box!BOX!/[Aa]ssets/Plugins/Editor/JetBrains*
# Jetbrains Rider personal-layer settings
*.DotSettings.user

# Visual Studio cache directory
.vs/

# Gradle cache directory
.gradle/

# Autogenerated VS/MD/Consulo solution and project files
ExportedObj/
.consulo/
*.csproj
*.unityproj
*.sln
*.slnx
*.suo
*.tmp
*.user
*.userprefs
*.pidb
*.booproj
*.svd
*.pdb
*.mdb
*.opendb
*.VC.db

# Unity3D generated meta files
*.pidb.meta
*.pdb.meta
*.mdb.meta

# Unity3D generated file on crash reports
sysinfo.txt

# Mono auto generated files
.dirstamp
mono_crash.*
tmpinst-dir.stamp

# Builds
/Box!Box!BOX!/*_BackUpThisFolder_ButDontShipItWithYourGame/
/Box!Box!BOX!/*_BurstDebugInformation_DoNotShip/
*.apk
*.aab
*.obb
*.unitypackage
*.unitypackage.meta
*.app

# Crashlytics generated file
crashlytics-build.properties

# Blender generated backup files
/Box!Box!BOX!/[Aa]ssets/**/*.blend1
/Box!Box!BOX!/[Aa]ssets/**/*.blend1.meta

# TouchDesigner generated cache files
/Box!Box!BOX!/[Aa]ssets/**/TDImportCache/
/Box!Box!BOX!/[Aa]ssets/**/TDImportCache.meta

# Unity Crash Recovery generated files
/Box!Box!BOX!/[Aa]ssets/_Recovery/
/Box!Box!BOX!/[Aa]ssets/_Recovery.meta

# Addressables default ignores, before user customizations
# By default, Addressables content builds will generate addressables_content_state.bin
# files in platform-specific subfolders, for example:
# /Box!Box!BOX!/Assets/AddressableAssetsData/OSX/addressables_content_state.bin
/Box!Box!BOX!/[Aa]ssets/AddressableAssetsData/*/addressables_content_state.bin
/Box!Box!BOX!/[Aa]ssets/AddressableAssetsData/*/addressables_content_state.bin.meta
/Box!Box!BOX!/[Aa]ssets/AddressableAssetsData/link.xml
/Box!Box!BOX!/[Aa]ssets/AddressableAssetsData/link.xml.meta
/Box!Box!BOX!/[Aa]ssets/Addressables_Temp/
/Box!Box!BOX!/[Aa]ssets/Addressables_Temp.meta
/Box!Box!BOX!/[Aa]ssets/StreamingAssets/aa/
/Box!Box!BOX!/[Aa]ssets/StreamingAssets/aa.meta
/Box!Box!BOX!/ServerData/

# EDM4U generated files
/Box!Box!BOX!/[Aa]ssets/GeneratedLocalRepo/
/Box!Box!BOX!/[Aa]ssets/GeneratedLocalRepo.meta

# Android Gradle generated files
/Box!Box!BOX!/[Aa]ssets/Plugins/Android/**/*.gradle.backup*
/Box!Box!BOX!/[Aa]ssets/Plugins/Android/**/local.properties

# Test Framework generated files
/Box!Box!BOX!/[Aa]ssets/Resources/PerformanceTestRunInfo.json
/Box!Box!BOX!/[Aa]ssets/Resources/PerformanceTestRunInfo.json.meta
/Box!Box!BOX!/[Aa]ssets/Resources/PerformanceTestRunSettings.json
/Box!Box!BOX!/[Aa]ssets/Resources/PerformanceTestRunSettings.json.meta
/Box!Box!BOX!/[Aa]ssets/InitTestScene*.unity
/Box!Box!BOX!/[Aa]ssets/InitTestScene*.unity.meta

# Visual Scripting auto-generated files
/Box!Box!BOX!/[Aa]ssets/Unity.VisualScripting.Generated/VisualScripting.Core/Property Providers/
/Box!Box!BOX!/[Aa]ssets/Unity.VisualScripting.Generated/VisualScripting.Core/Property Providers.meta
/Box!Box!BOX!/[Aa]ssets/Unity.VisualScripting.Generated/VisualScripting.Flow/UnitOptions.db
/Box!Box!BOX!/[Aa]ssets/Unity.VisualScripting.Generated/VisualScripting.Flow/UnitOptions.db.meta

# UI Toolkit auto generated files
/Box!Box!BOX!/UIElementsSchema/

# Auto-generated cache in Assets folder
/Box!Box!BOX!/[Aa]ssets/[Ss]ceneDependencyCache*

# TextMesh Pro - esempi e tutorial
/Box!Box!BOX!/Assets/TextMesh Pro/Examples & Extras/
/Box!Box!BOX!/Assets/TextMesh Pro/Examples & Extras.meta
